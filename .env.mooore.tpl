# ムーア用。値は 1Password（vault Dev）。実行: op run --env-file=.env.mooore.tpl -- <cmd>
# Railway の Variables には、Railway の画面または `op run -- railway variables --set ...` で入れる。
NEXT_PUBLIC_WEBAPP_URL=https://sign.mooores.com
NEXT_PRIVATE_INTERNAL_WEBAPP_URL=http://localhost:3000
NEXTAUTH_SECRET=op://Dev/mooore-sign/NEXTAUTH_SECRET
NEXT_PRIVATE_ENCRYPTION_KEY=op://Dev/mooore-sign/ENCRYPTION_KEY
NEXT_PRIVATE_ENCRYPTION_SECONDARY_KEY=op://Dev/mooore-sign/ENCRYPTION_SECONDARY_KEY
NEXT_PRIVATE_DATABASE_URL=op://Dev/mooore-sign/DATABASE_URL_POOLER
# DIRECT には Supabase の Session pooler（5432）を入れる。Direct 接続は IPv6 専用
NEXT_PRIVATE_DIRECT_DATABASE_URL=op://Dev/mooore-sign/DATABASE_URL_DIRECT
# Railway の Hobby プランは外向き SMTP（465/587）を塞ぐため、Resend の HTTP API を使う
NEXT_PRIVATE_SMTP_TRANSPORT=resend
NEXT_PRIVATE_RESEND_API_KEY=op://Dev/mooore-sign/RESEND_API_KEY
NEXT_PRIVATE_SMTP_FROM_NAME=ムーア株式会社
NEXT_PRIVATE_SMTP_FROM_ADDRESS=sign@mail.mooores.com
NEXT_PUBLIC_UPLOAD_TRANSPORT=s3
NEXT_PRIVATE_UPLOAD_ENDPOINT=op://Dev/mooore-sign/S3_ENDPOINT
NEXT_PRIVATE_UPLOAD_FORCE_PATH_STYLE=true
NEXT_PRIVATE_UPLOAD_REGION=ap-northeast-1
NEXT_PRIVATE_UPLOAD_BUCKET=op://Dev/mooore-sign/S3_BUCKET
NEXT_PRIVATE_UPLOAD_ACCESS_KEY_ID=op://Dev/mooore-sign/S3_ACCESS_KEY_ID
NEXT_PRIVATE_UPLOAD_SECRET_ACCESS_KEY=op://Dev/mooore-sign/S3_SECRET_ACCESS_KEY
NEXT_PRIVATE_SIGNING_TRANSPORT=local
NEXT_PRIVATE_SIGNING_LOCAL_FILE_CONTENTS=op://Dev/mooore-sign/SIGNING_P12_BASE64
NEXT_PRIVATE_SIGNING_PASSPHRASE=op://Dev/mooore-sign/SIGNING_PASSPHRASE
NEXT_PRIVATE_SIGNING_REASON=ムーア株式会社 電子署名
NEXT_PUBLIC_SIGNING_CONTACT_INFO=sign@mail.mooores.com
DOCUMENSO_DISABLE_TELEMETRY=true
PORT=3000
# NEXT_PUBLIC_DISABLE_SIGNUP=true は、最初の管理者を作ったあとに Railway へ足す（ops.md の手順 8）。ここでは入れない
